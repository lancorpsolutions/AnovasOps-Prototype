# HubSpot Private App access token (Settings > Integrations > Private Apps).
# Required scope: crm.objects.contacts.write
# Without this set, lead magnet form submissions still unlock the PDF download
# but are not synced to HubSpot.
HUBSPOT_ACCESS_TOKEN=

# Optional: override which HubSpot contact property stores the lead magnet
# name. Defaults to the built-in "hs_analytics_last_touch_converting_campaign"
# property since this portal has no dedicated custom property yet. Once a
# custom property (e.g. "lead_magnet") is created in HubSpot, set its
# internal name here instead.
HUBSPOT_LEAD_MAGNET_PROPERTY=

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials).
# Start with a Sandbox app; swap to a Live app's credentials + base URL when
# ready to take real payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Same Client ID as above, exposed to the browser for the PayPal JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Billing Plan IDs for each AnovasOS tier (not secret — same idea as a Stripe
# price ID — used by both the browser checkout button and the server-side
# verification route). Generate these once by running
# `npm run setup:paypal-plans` (requires PAYPAL_CLIENT_ID/SECRET above to be
# set first), then paste the printed values here.
NEXT_PUBLIC_PAYPAL_PLAN_STARTUP_ID=
NEXT_PUBLIC_PAYPAL_PLAN_SMALL_BUSINESS_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ENTERPRISE_ID=
