# HubSpot Private App access token (Settings > Integrations > Private Apps).
# Required scope: crm.objects.contacts.write
# Without this set, lead magnet form submissions still unlock the PDF download
# but are not synced to HubSpot.
HUBSPOT_ACCESS_TOKEN=

# Optional: override which HubSpot contact property stores the lead magnet
# name. Defaults to the built-in "hs_analytics_last_touch_converting_campaign"
# property since this portal has no dedicated custom property yet. Once a
# custom property (e.g. "lead_magnet") is created in HubSpot, set its
# internal name here instead.
HUBSPOT_LEAD_MAGNET_PROPERTY=
