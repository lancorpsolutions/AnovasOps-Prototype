# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://anovasintegratedsystems.com

# Booking tool for /book. Defaults to the existing Calendly discovery-call
# event. A HubSpot Meetings link also works (meeting_booked tracking is
# Calendly-only; see docs/analytics-and-conversion-spec.md).
NEXT_PUBLIC_BOOKING_URL=

# ── HubSpot CRM (server-side only — never prefix with NEXT_PUBLIC_) ─────────
# Private App access token (Settings > Integrations > Private Apps).
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write.
# Notes and tasks are created against the contact; on the first live test,
# check server logs for "[leads] note failed"/"task failed" with a 403 and add
# the scope HubSpot names in the error if one is reported.
# Add crm.schemas.contacts.write only while running
# scripts/hubspot-create-properties.mjs.
# Without a token, submissions still succeed for the visitor but are not
# synced; set LEAD_FALLBACK_WEBHOOK_URL so they aren't only in server logs.
HUBSPOT_ACCESS_TOKEN=

# Optional: HubSpot owner ID that new website contacts are assigned to and
# that follow-up tasks are created for. Leave empty to skip owner assignment
# and task creation.
HUBSPOT_DEFAULT_OWNER_ID=

# Set to "enabled" ONLY after running scripts/hubspot-create-properties.mjs.
# Writes anovas_* properties (conversion offer, diagnostic score, UTMs).
# Writing properties that don't exist makes HubSpot reject the whole request.
HUBSPOT_CUSTOM_PROPERTIES=

# Optional: receives the full lead JSON when HubSpot sync fails or is not
# configured (e.g. an n8n/Zapier webhook that emails the team).
LEAD_FALLBACK_WEBHOOK_URL=

# Optional: existing n8n automation for Autopilot/diagnostic inquiries.
N8N_AUTOPILOT_LEAD_WEBHOOK_URL=

# ── Analytics (loaded only after the visitor accepts the consent banner) ────
# GA4 measurement ID, format G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# HubSpot portal ID for the tracking code (245271977 for the AIS portal).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# "na2" (default, matches app-na2.hubspot.com) or "na1".
NEXT_PUBLIC_HUBSPOT_REGION=

# ── AnovasOS app (Supabase) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── PayPal (developer.paypal.com > Apps & Credentials) ──────────────────────
# Start with a Sandbox app; swap to a Live app's credentials + base URL when
# ready to take real payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Same Client ID as above, exposed to the browser for the PayPal JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Billing Plan IDs for each AnovasOS tier (not secret). Generate with
# `npm run setup:paypal-plans`, then paste the printed values here.
NEXT_PUBLIC_PAYPAL_PLAN_STARTUP_ID=
NEXT_PUBLIC_PAYPAL_PLAN_SMALL_BUSINESS_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ENTERPRISE_ID=
